<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAL\DAL.csproj" />
    <ProjectReference Include="..\DTOs\DTOs.csproj" />
  </ItemGroup>

  <!-- שכבת ה-BLL ניגשת למידע רק דרך ה-Repositories שב-DAL,
       ולכן אין לה יותר הפניה ישירה ל-Entity Framework. -->
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
    <PackageReference Include="Hangfire" Version="1.8.25" />
    <!-- Hangfire תלוי ב-Newtonsoft.Json >= 11.0.1, גרסה עם פרצת אבטחה ידועה (NU1903).
         ההפניה המפורשת מכריחה גרסה מתוקנת. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>